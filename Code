local function notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {Title = title, Text = text, Duration = dur or 3})
    end)
end

local function getAimPart(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    local head = char:FindFirstChild("Head")
    if head and head:IsA("BasePart") and head.Transparency < 1 then
        return head
    end

    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower():find("head") and d.Transparency < 1 then
            return d
        end
    end

    local top, topY
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 1 then
            local y = d.Position.Y
            if not topY or y > topY then
                top, topY = d, y
            end
        end
    end
    return top
end

local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function sameTeam(char)
    local plr = Players:GetPlayerFromCharacter(char)
    return plr ~= nil and plr.Team ~= nil and plr.Team == Player.Team
end

local function isVisibleFrom(part, char)
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local myChar = Player.Character
    if myChar then
        params.FilterDescendantsInstances = {myChar, char}
    else
        params.FilterDescendantsInstances = {char}
    end
    local hit = Workspace:Raycast(origin, dir, params)
    return hit == nil or hit.Instance:IsDescendantOf(char)
end

local function getAimCenter()
    if Settings.FollowMouse then
        local m = UIS:GetMouseLocation()
        return Vector2.new(m.X, m.Y)
    end
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function isGhost(char)
    local anyVisible = false
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 0.99 then
            anyVisible = true
            break
        end
    end
    return not anyVisible
end

local function espVisible(char, head)
    local pts = {head}
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if torso then pts[#pts + 1] = torso end
    if hrp then pts[#pts + 1] = hrp end
    for _, p in ipairs(pts) do
        if isVisibleFrom(p, char) then
            return true
        end
    end
    return false
end

