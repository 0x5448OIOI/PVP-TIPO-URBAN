local function updateESP()
    for char, obj in pairs(espObjects) do
        if not char:IsDescendantOf(Workspace) then
            destroyESPObject(obj)
            espObjects[char] = nil
        else
            local hum = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local show = false
            local mag = 0

            if Settings.ESP and hum and hum.Health > 0 and head and not (Settings.IgnoreGhosts and isGhost(char)) then
                mag = (head.Position - Camera.CFrame.Position).Magnitude
                if mag <= Settings.ESPMaxDist then
                    local now = os.clock()
                    if now - obj.lastVisCheck > 0.15 then
                        obj.lastVisCheck = now
                        obj.isVis = espVisible(char, head)
                    end

                    if obj.isVis or Settings.ESPWalls then
                        local okBB, cf, bsize = pcall(function()
                            local c, s = char:GetBoundingBox()
                            return c, s
                        end)
                        if okBB then
                            local minX, minY, maxX, maxY, any
                            for cx = -1, 1, 2 do
                                for cy = -1, 1, 2 do
                                    for cz = -1, 1, 2 do
                                        local p = (cf * CFrame.new(bsize.X / 2 * cx, bsize.Y / 2 * cy, bsize.Z / 2 * cz)).Position
                                        local sp = Camera:WorldToViewportPoint(p)
                                        if sp.Z > 0 then
                                            any = true
                                            if not minX or sp.X < minX then minX = sp.X end
                                            if not maxX or sp.X > maxX then maxX = sp.X end
                                            if not minY or sp.Y < minY then minY = sp.Y end
                                            if not maxY or sp.Y > maxY then maxY = sp.Y end
                                        end
                                    end
                                end
                            end
                            if any then
                                local vw, vh = Camera.ViewportSize.X, Camera.ViewportSize.Y
                                if maxX > -60 and minX < vw + 60 and maxY > -60 and minY < vh + 60 then
                                    show = true
                                    obj.box.Color = Settings.ColorBox
                                    obj.name.Color = Settings.ColorName
                                    obj.dist.Color = Settings.ColorName
                                    local w, h = maxX - minX, maxY - minY

                                    obj.box.Position = Vector2.new(minX, minY)
                                    obj.box.Size = Vector2.new(w, h)
                                    obj.box.Visible = Settings.Box

                                    local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                                    local hpX = minX - 7
                                    obj.hpBg.Position = Vector2.new(hpX, minY)
                                    obj.hpBg.Size = Vector2.new(4, h)
                                    obj.hpBg.Visible = Settings.HealthBar
                                    local hgt = h * pct
                                    obj.hp.Position = Vector2.new(hpX + 1, minY + (h - hgt))
                                    obj.hp.Size = Vector2.new(2, hgt)
                                    obj.hp.Color = Color3.fromRGB(240 - pct * 155, 80 + pct * 140, 60)
                                    obj.hp.Visible = Settings.HealthBar

                                    obj.name.Text = char.Name
                                    obj.name.Position = Vector2.new(minX + w / 2, minY - 17)
                                    obj.name.Visible = Settings.Name

                                    obj.dist.Text = ("%d studs"):format(mag + 0.5)
                                    obj.dist.Position = Vector2.new(minX + w / 2, maxY + 3)
                                    obj.dist.Visible = Settings.Distance
                                end
                            end
                        end
                    end
                end
            end

            if not show then
                obj.box.Visible = false
                obj.hpBg.Visible = false
                obj.hp.Visible = false
                obj.name.Visible = false
                obj.dist.Visible = false
            end

            if show and Settings.Photo then
                local plr = Players:GetPlayerFromCharacter(char)
                if not obj.bb then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "0x5448_Photo"
                    bb.LightInfluence = 0
                    bb.Active = false

                    local img = Instance.new("ImageLabel")
                    img.Name = "Img"
                    img.BackgroundTransparency = 1
                    img.Size = UDim2.fromScale(1, 1)
                    img.Parent = bb

                    local txt = Instance.new("TextLabel")
                    txt.Name = "Initial"
                    txt.BackgroundTransparency = 1
                    txt.Size = UDim2.fromScale(1, 1)
                    txt.Font = Enum.Font.GothamBold
                    txt.TextScaled = true
                    txt.TextColor3 = Color3.fromRGB(210, 160, 255)
                    txt.Text = ""
                    txt.Parent = bb

                    obj.bb = bb
                    obj.bbImg = img
                    obj.bbTxt = txt
                    bb.Parent = head
                end

                local stpp = 2 * mag * math.tan(math.rad(Camera.FieldOfView * 0.5)) / math.max(Camera.ViewportSize.Y, 1)
                local px = Settings.PhotoSize
                local st = px * stpp
                st = math.clamp(st, 0.1, 400)
                obj.bb.Size = UDim2.new(0, st, 0, st)

                local spH = Camera:WorldToViewportPoint(head.Position)
                local headY = (spH.Z > 0) and spH.Y or (Camera.ViewportSize.Y / 2)
                local nameY = obj.name.Visible and obj.name.Position.Y or (headY - 18)
                local upPx = math.max(headY - (nameY - px / 2 - 6), 10)
                obj.bb.StudsOffsetWorldSpace = Vector3.new(0, upPx * stpp, 0)
                obj.bb.AlwaysOnTop = Settings.ESPWalls
                obj.bb.Enabled = true

                if plr then
                    obj.bbImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=150&h=150"
                    obj.bbImg.BackgroundTransparency = 1
                    obj.bbImg.Visible = true
                    obj.bbTxt.Visible = false
                else
                    obj.bbImg.Image = ""
                    obj.bbImg.Visible = false
                    obj.bbTxt.Text = char.Name:sub(1, 1)
                    obj.bbTxt.Visible = true
                end
            elseif obj.bb then
                obj.bb.Enabled = false
            end
        end
    end
end

