local function getBestTarget()
    local best, bestPart, bestDist
    local center = getAimCenter()

    local function consider(char)
        if not isAlive(char) then return end
        if Settings.TeamCheck and sameTeam(char) then return end
        if Settings.IgnoreGhosts and isGhost(char) then return end
        local part = getAimPart(char)
        if not part then return end
        if (part.Position - Camera.CFrame.Position).Magnitude > Settings.MaxDist then return end
        if Settings.AimWallCheck and not isVisibleFrom(part, char) then return end

        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then return end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d > Settings.FOV then return end

        if not bestDist or d < bestDist then
            best, bestPart, bestDist = char, part, d
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player and plr.Character then
            consider(plr.Character)
        end
    end
    if Settings.AimNPC then
        for _, hum in ipairs(Workspace:GetDescendants()) do
            if hum:IsA("Humanoid") and hum.Health > 0 then
                local char = hum.Parent
                if char and char:IsA("Model") and not Players:GetPlayerFromCharacter(char) then
                    consider(char)
                end
            end
        end
    end
    return best, bestPart, bestDist
end

