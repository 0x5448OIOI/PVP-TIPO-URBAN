UIS.InputBegan:Connect(function(input, gp)
    if capturing then
        if input.KeyCode == Enum.KeyCode.Escape then
            capturing = false
            if captureBtn then captureBtn.Text = keyDisplay(Settings.AimKey) end
            return
        end
        local key
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
            key = input.UserInputType
        elseif input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode ~= nil then
            key = input.KeyCode
        end
        if key then
            capturing = false
            Settings.AimKey = key
            if captureBtn then captureBtn.Text = keyDisplay(key) end
            captureBtn = nil
        end
        return
    end

    if input.UserInputType == Settings.AimKey or input.KeyCode == Settings.AimKey then
        keyHeld = true
    end

