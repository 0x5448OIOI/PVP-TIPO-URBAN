local function addToggle(page, label, default, callback)
    local state = default and true or false
    local row = make("Frame", {Size = UDim2.new(1, -6, 0, 30), BackgroundColor3 = C.row, BorderSizePixel = 0}, page)
    make("UICorner", {CornerRadius = UDim.new(0, 6)}, row)
    make("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -70, 1, 0), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, Text = label}, row)

    local pill = make("Frame", {Size = UDim2.fromOffset(38, 18), Position = UDim2.new(1, -48, 0.5, -9), BackgroundColor3 = C.off, BorderSizePixel = 0}, row)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, pill)
    local knob = make("Frame", {Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = C.sub, BorderSizePixel = 0}, pill)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)

    local function render()
        pill.BackgroundColor3 = state and C.accent or C.off
        knob.Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
        knob.BackgroundColor3 = state and Color3.fromRGB(24, 17, 31) or C.sub
    end

    local btn = make("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = ""}, row)
    btn.MouseButton1Click:Connect(function()
        state = not state
        render()
        if callback then callback(state) end
    end)
    render()
    return {
        set = function(v)
            state = v and true or false
            render()
            if callback then callback(state) end
        end,
        get = function() return state end,
    }
end

local function addSlider(page, label, min, max, default, callback, fmt)
    fmt = fmt or function(v) return tostring(math.floor(v + 0.5)) end
    local value = default

    local row = make("Frame", {Size = UDim2.new(1, -6, 0, 44), BackgroundColor3 = C.row, BorderSizePixel = 0}, page)
    make("UICorner", {CornerRadius = UDim.new(0, 6)}, row)
    make("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -60, 0, 16), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, Text = label}, row)
    local vlabel = make("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(1, -70, 0, 2), Size = UDim2.fromOffset(60, 16), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.accent, TextXAlignment = Enum.TextXAlignment.Right, Text = ""}, row)

    local bar = make("Frame", {Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 28), BackgroundColor3 = C.off, BorderSizePixel = 0}, row)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, bar)
    local fill = make("Frame", {Size = UDim2.new(0.5, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0}, bar)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)

    local hit = make("TextButton", {Size = UDim2.new(1, -20, 0, 18), Position = UDim2.fromOffset(10, 22), BackgroundTransparency = 1, Text = ""}, row)

    local function render(v)
        local pct = math.clamp((v - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        vlabel.Text = fmt(v)
    end

    hit.MouseButton1Down:Connect(function()
        activeSlider = {min = min, max = max, bar = bar, render = render, callback = callback}
    end)

    render(value)
    callback(value)
end

