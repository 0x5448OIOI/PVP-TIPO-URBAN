local function stickyInvalid()
    if not stickyChar then return true end
    local hum = stickyChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return true end
    local part = getAimPart(stickyChar)
    if not part then return true end
    if (part.Position - Camera.CFrame.Position).Magnitude > Settings.MaxDist then return true end
    if Settings.AimWallCheck then
        if not isVisibleFrom(part, stickyChar) then
            if os.clock() - lastSeenTime > 0.35 then return true end
        else
            lastSeenTime = os.clock()
        end
    else
        lastSeenTime = os.clock()
    end
    return false
end

